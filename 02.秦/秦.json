[
  {
    "id": "6aa1f9ed72f86693a9b31022",
    "title": "三秦民谣",
    "dynasty": "秦",
    "authorName": "无名氏",
    "verses": [
      "武功太白，去天三百。",
      "孤云两角，去天一握。",
      "山水险阻，黄金子午。",
      "蛇盘鸟栊，势与天通。"
    ]
  },
  {
    "id": "6aa1f9ed72f86693a9b31023",
    "title": "巴谣歌",
    "dynasty": "秦",
    "authorName": "阙名",
    "verses": [
      "神仙得者茅初成，驾龙上升入太清。",
      "时下玄洲戏赤城，继世而往在我盈，帝若学之腊嘉平。"
    ]
  }
]
